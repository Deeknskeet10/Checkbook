<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="PendingRealignmentsQueue" version="0.1.0" display-name-key="PendingRealignmentsQueue" description-key="Queue view of Realignments waiting to be approved. Cards show debit -- credit prioritization flow, amount, payer/payee concurrence, and state-approval status. Aggregate totals at top, drill-through to record on click." control-type="virtual">
    <data-set name="realignments" display-name-key="Pending Realignments">
      <property-set name="name" display-name-key="Name" of-type="SingleLine.Text" usage="bound" required="false" />
      <property-set name="amount" display-name-key="Amount" of-type="FP" usage="bound" required="true" />
      <property-set name="status" display-name-key="Status" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="debitedPrioritization" display-name-key="Debited Prioritization" of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="creditedPrioritization" display-name-key="Credited Prioritization" of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="payerConcurrence" display-name-key="Payer Concurrence" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="payeeConcurrence" display-name-key="Payee Concurrence" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="stateApproved" display-name-key="State Approved" of-type="TwoOptions" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/PendingRealignmentsQueue.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
