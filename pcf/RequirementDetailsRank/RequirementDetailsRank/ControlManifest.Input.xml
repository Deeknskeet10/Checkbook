<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="RequirementDetailsRank" version="0.1.0" display-name-key="RequirementDetailsRank" description-key="Drag-to-reorder list of book_requirementdetails under a Requirement. Each detail inherits the parent Requirement's priority (e.g. 5) and is suffixed by its order in the list (5.1, 5.2, 5.3...). Drop to renumber book_priorityorder via Web API." control-type="virtual">
    <data-set name="details" display-name-key="Requirement Details">
      <property-set name="name" display-name-key="Name" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="priorityOrder" display-name-key="Priority Order" of-type="Whole.None" usage="bound" required="true" />
      <property-set name="item" display-name-key="Item" of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="category" display-name-key="Category" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="quantityType" display-name-key="Quantity Type" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="tdc" display-name-key="TDC" of-type="FP" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/RequirementDetailsRank.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
