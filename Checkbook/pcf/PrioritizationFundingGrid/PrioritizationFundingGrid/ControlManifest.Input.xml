<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="PrioritizationFundingGrid" version="0.2.12"
           display-name-key="PrioritizationFundingGrid"
           description-key="Requirement-form hub for NPM Validate and Fund. Lists child Prioritizations with batch Edit/Save of Validated and Funded amounts (expandable to per-line Itemized Details when present), and an Allocate-to-RFs dialog per Prioritization that splits the Prio Funded total across multiple Requirement Fundings via book_prioritizationfunding rows. TDP guardrail aggregates across every RF on the Requirement."
           control-type="virtual" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- Bound to the book_prioritization subgrid on the Requirement form
         (filter the subgrid view to the parent Requirement). -->
    <data-set name="prioritizations" display-name-key="Prioritizations">
      <property-set name="name" display-name-key="Name"
                    of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="statePriority" display-name-key="State Priority"
                    of-type="Whole.None" usage="bound" required="false" />
      <property-set name="approvalStatus" display-name-key="Approval Status"
                    of-type="OptionSet" usage="bound" required="false" />
      <property-set name="fiscalYear" display-name-key="Fiscal Year"
                    of-type="OptionSet" usage="bound" required="false" />
      <property-set name="fundingMode" display-name-key="Funding Mode"
                    of-type="OptionSet" usage="bound" required="false" />
      <property-set name="requestedAmount" display-name-key="Requested Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="fundedAmount" display-name-key="Funded Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="validatedAmount" display-name-key="Validated Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="requirement" display-name-key="Requirement"
                    of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="state" display-name-key="State"
                    of-type="Lookup.Simple" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/PrioritizationFundingGrid.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
