<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="ValidateAndFundGrid" version="0.1.8"
           display-name-key="ValidateAndFundGrid"
           description-key="NPM one-stop Validate and Fund grid for a Requirement Funding: edit Validated/Funded across child Prioritizations directly, or expand a Prioritization that has Itemized Details to fund those line items. Batch Edit/Save with an Available-TDP over-allocation guardrail."
           control-type="virtual" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- Bound to the book_prioritization subgrid on the Requirement Funding form. -->
    <data-set name="prioritizations" display-name-key="Prioritizations">
      <property-set name="state" display-name-key="State"
                    of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="statePriority" display-name-key="State Priority"
                    of-type="Whole.None" usage="bound" required="false" />
      <property-set name="requestedAmount" display-name-key="Requested Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="validatedAmount" display-name-key="Validated Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="fundedAmount" display-name-key="Funded Amount"
                    of-type="Decimal" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/ValidateAndFundGrid.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
