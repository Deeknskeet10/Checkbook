      <property-set name="endDate" display-name-key="End Date" of-type="DateAndTime.DateOnly" usage="bound" required="false" />
      <property-set name="fundingType" display-name-key="Funding Type" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="fiscalYear" display-name-key="Fiscal Year" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="description" display-name-key="Description" of-type="Multiple" usage="bound" required="false" />
