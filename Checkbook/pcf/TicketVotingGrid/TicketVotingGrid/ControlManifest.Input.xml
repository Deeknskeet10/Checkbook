<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="TicketVotingGrid" version="0.1.0"
           display-name-key="TicketVotingGrid"
           description-key="Reddit-style voting board for the book_ticket table. Renders each ticket as a row with up/down endorsement arrows and a running score, a ticket-type filter, and a deep link to the ticket form. Arrows call the book_CastVote Custom API, which toggles the caller book_ticketendorsement row and recomputes book_score server-side."
           control-type="virtual" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- Bound to a book_ticket view/subgrid. Sort the view by book_score desc. -->
    <data-set name="tickets" display-name-key="Tickets">
      <property-set name="name" display-name-key="Title"
                    of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="ticketType" display-name-key="Ticket Type"
                    of-type="OptionSet" usage="bound" required="false" />
      <property-set name="ticketStatus" display-name-key="Status"
                    of-type="OptionSet" usage="bound" required="false" />
      <property-set name="score" display-name-key="Score"
                    of-type="Whole.None" usage="bound" required="false" />
      <property-set name="owner" display-name-key="Submitted By"
                    of-type="Lookup.Simple" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/TicketVotingGrid.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
