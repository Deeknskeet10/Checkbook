<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="ValidateAndFundRequirementDetailsGrid" version="0.1.0"
           display-name-key="ValidateAndFundRequirementDetailsGrid"
           description-key="NPM Validate and Fund grid for a Requirement Funding whose parent Requirement has no Prioritization: edit Validated/Funded directly on each Requirement Detail allocation. Batch Edit/Save with an Available-TDP over-allocation guardrail."
           control-type="virtual" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- Bound to the book_requirementdetailfunding subgrid on the Requirement Funding form.
         Each row is a per-(RD, RF) allocation; the parent RD is read from the lookup. -->
    <data-set name="requirementDetailFundings" display-name-key="Requirement Detail Fundings">
      <property-set name="requirementDetail" display-name-key="Requirement Detail"
                    of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="name" display-name-key="Name"
                    of-type="SingleLine.Text" usage="bound" required="false" />
      <property-set name="validatedAmount" display-name-key="Validated Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="fundedAmount" display-name-key="Funded Amount"
                    of-type="Decimal" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/ValidateAndFundRequirementDetailsGrid.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
