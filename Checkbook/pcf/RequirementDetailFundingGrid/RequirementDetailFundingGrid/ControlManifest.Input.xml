<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="RequirementDetailFundingGrid" version="0.1.1"
           display-name-key="RequirementDetailFundingGrid"
           description-key="Lists Requirement Details for a Requirement (no-Prio path) and lets the NPM allocate funding from the Requirement RFs via book_requirementdetailfunding junction rows. Each RD shows its current per-RF allocations inline with editable Funded/Validated amounts and an Add-from-RF dropdown; a toolbar FY filter narrows the picker."
           control-type="virtual" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- Bound to the book_requirementdetails subgrid on the Requirement form
         (filter the subgrid view to the parent Requirement). -->
    <data-set name="requirementDetails" display-name-key="Requirement Details">
      <property-set name="name" display-name-key="Name"
                    of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="item" display-name-key="Item"
                    of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="mdep" display-name-key="MDEP"
                    of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="tdc" display-name-key="TDC"
                    of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="priorityOrder" display-name-key="Priority Order"
                    of-type="Whole.None" usage="bound" required="false" />
      <property-set name="fundedAmount" display-name-key="Funded Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="validatedAmount" display-name-key="Validated Amount"
                    of-type="Decimal" usage="bound" required="false" />
      <property-set name="requirement" display-name-key="Requirement"
                    of-type="Lookup.Simple" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/RequirementDetailFundingGrid.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
