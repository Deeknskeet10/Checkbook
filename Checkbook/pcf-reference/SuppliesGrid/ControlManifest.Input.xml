<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="SuppliesGrid" version="0.6.0" display-name-key="SuppliesGrid" description-key="Editable supplies grid with NSN validation and completeness gating." control-type="virtual">
    <data-set name="supplies" display-name-key="Supplies">
      <property-set name="item" display-name-key="Supply Item" of-type="Lookup.Simple" usage="bound" required="true" />
      <property-set name="quantity" display-name-key="Quantity" of-type="Whole.None" usage="bound" required="true" />
      <property-set name="estimatedCost" display-name-key="Estimated Cost" of-type="FP" usage="bound" required="true" />
      <property-set name="itemClass" display-name-key="Item Class" of-type="OptionSet" usage="bound" required="false" />
      <property-set name="notes" display-name-key="Notes" of-type="Multiple" usage="bound" required="false" />
    </data-set>
    <property name="requirementIdField" display-name-key="Parent Requirement Id (context)" description-key="Field on the parent Prioritization that holds the Requirement lookup." of-type="SingleLine.Text" usage="input" required="false" />
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/SuppliesGrid.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
