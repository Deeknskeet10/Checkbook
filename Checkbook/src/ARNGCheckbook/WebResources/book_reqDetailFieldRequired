function onBookItemChange(executionContext) {
    var formContext = executionContext.getFormContext();

    if(formContext.getAttribute("book_linrequired").getValue() || formContext.getAttribute("book_countryrequired").getValue())
    {
        formContext.getAttribute("book_tdc").setRequiredLevel("required");
	    return;
    }

    var bookItem = formContext.getAttribute("book_item").getValue();

    // Clear requirement and value initially
    formContext.getAttribute("book_tdc").setRequiredLevel("none");

    if (!bookItem) {
        return; // nothing selected
    }

    var bookItemId = bookItem[0].id.replace(/[{}]/g, "");

    // Query book_tdc records filtered by the selected book_item
    Xrm.WebApi.retrieveMultipleRecords("book_tdc", 
        "?$select=book_tdcid&$filter=_book_item_value eq " + bookItemId
    ).then(function (result) {

        if (result.entities.length > 0) {
            // At least one related book_tdc exists → make field required
            formContext.getAttribute("book_tdc").setRequiredLevel("required");
        } else {
            // No related items → field optional
            formContext.getAttribute("book_tdc").setRequiredLevel("none");
        }

    }, function (error) {
        console.log("Error checking book_tdc records:", error);
    });
}

function onBookLinOrCountryChange(executionContext) {
    var context = executionContext.getFormContext();

    if(context.getAttribute("book_linrequired").getValue() || context.getAttribute("book_countryrequired").getValue())
        context.getAttribute("book_tdc").setRequiredLevel("required");
}

var TDCFilter = TDCFilter || {}

TDCFilter.triggerPreSearch = function (ec){
    let context =  ec.getFormContext();

    context.getControl('book_tdc').removePreSearch(TDCFilter.preSearch);

    if(!context.getAttribute("book_linrequired").getValue() && !context.getAttribute("book_countryrequired").getValue())
        context.getControl('book_tdc').addPreSearch(TDCFilter.preSearch);
}

TDCFilter.preSearch = function (ec){
    let context = ec.getFormContext();
    let item = context.getAttribute('book_item').getValue();

    if(item && item[0]){
        let itemId = item[0].id;

        let filter = `
        <filter type='and'>
            <condition attribute='book_item' operator='eq' value='${itemId}'/>
        </filter>
        `;

        context.getControl('book_tdc').addCustomFilter(filter, 'book_tdc');
    }
}