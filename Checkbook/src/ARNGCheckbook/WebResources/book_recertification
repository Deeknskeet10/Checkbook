// Command-bar entry points for the Certify / Decertify buttons on a view of
// Requirements. Register as JScript web resource "book_recertification" and
// point the modern commands' Run JavaScript actions at:
//   Recertification.certify    (pass SelectedControl)
//   Recertification.decertify  (pass SelectedControl)
//
// Toggles book_recertified (two-options) across every selected row.
// Calls the Dataverse Web API directly via fetch — Xrm.WebApi.updateRecord
// rejects with "Cannot convert ODataContract with $batch operation into a
// serialized request" at the SDK layer (even for a single row), so we bypass
// it entirely.
var Recertification = (function () {
  "use strict";

  var FIELD = "book_recertified";
  // Concurrency cap per wave — small enough to stay under throttling limits
  // while still finishing ~1600 rows quickly.
  var WAVE_SIZE = 40;

  var entitySetNameCache = {};

  function certify(selectedControl)   { return run(selectedControl, true,  "Certify"); }
  function decertify(selectedControl) { return run(selectedControl, false, "Decertify"); }

  function run(selectedControl, value, verb) {
    var selection = readSelection(selectedControl);
    if (!selection) return;
    if (selection.ids.length === 0) {
      Xrm.Navigation.openAlertDialog({ text: "Select one or more rows first." });
      return;
    }

    Xrm.Navigation.openConfirmDialog(
      {
        title: verb,
        text: verb + " " + selection.ids.length + " " + selection.entityName + " record(s)?\n\n" +
              FIELD + " will be set to " + (value ? "Yes" : "No") + "."
      },
      { height: 200, width: 420 }
    ).then(function (result) {
      if (!result || !result.confirmed) return;
      execute(selectedControl, selection, value, verb);
    });
  }

  function readSelection(selectedControl) {
    try {
      var grid = selectedControl.getGrid();
      var rows = grid.getSelectedRows().getAll();
      var ids = [];
      var entityName = null;
      for (var i = 0; i < rows.length; i++) {
        var ent = rows[i].getData().getEntity();
        if (!entityName) entityName = ent.getEntityName();
        ids.push(String(ent.getId()).replace(/[{}]/g, "").toLowerCase());
      }
      return { ids: ids, entityName: entityName };
    } catch (e) {
      Xrm.Navigation.openErrorDialog({
        message: "Could not read the selected rows.",
        details: (e && e.message) || String(e)
      });
      return null;
    }
  }

  function execute(selectedControl, selection, value, verb) {
    var total = selection.ids.length;
    var done = 0;
    var failures = [];

    Xrm.Utility.showProgressIndicator(verb + "… 0 of " + total);

    getEntitySetName(selection.entityName).then(
      function (setName) {
        runWave(setName);
      },
      function (err) {
        Xrm.Utility.closeProgressIndicator();
        Xrm.Navigation.openErrorDialog({
          message: "Could not resolve entity metadata for " + selection.entityName + ".",
          details: (err && err.message) || String(err)
        });
      }
    );

    function runWave(setName) {
      if (done >= total) {
        Xrm.Utility.closeProgressIndicator();
        showResult(selectedControl, verb, total, failures);
        return;
      }
      var chunk = selection.ids.slice(done, done + WAVE_SIZE);
      sendWave(setName, chunk, value).then(function (waveFailures) {
        done += chunk.length;
        if (waveFailures && waveFailures.length) {
          failures = failures.concat(waveFailures);
        }
        Xrm.Utility.showProgressIndicator(verb + "… " + done + " of " + total);
        runWave(setName);
      });
    }
  }

  function getEntitySetName(logicalName) {
    if (entitySetNameCache[logicalName]) {
      return Promise.resolve(entitySetNameCache[logicalName]);
    }
    var base = Xrm.Utility.getGlobalContext().getClientUrl();
    var url = base + "/api/data/v9.2/EntityDefinitions(LogicalName='" + logicalName + "')?$select=EntitySetName";
    return fetch(url, {
      method: "GET",
      headers: {
        "OData-MaxVersion": "4.0",
        "OData-Version": "4.0",
        "Accept": "application/json"
      }
    }).then(function (resp) {
      if (!resp.ok) {
        return resp.text().then(function (t) {
          throw new Error("HTTP " + resp.status + " " + t);
        });
      }
      return resp.json();
    }).then(function (json) {
      var setName = json && json.EntitySetName;
      if (!setName) throw new Error("EntitySetName missing from metadata response");
      entitySetNameCache[logicalName] = setName;
      return setName;
    });
  }

  function sendWave(setName, ids, value) {
    var body = {};
    body[FIELD] = value;
    var bodyJson = JSON.stringify(body);
    var fails = [];

    var promises = ids.map(function (id) {
      return updateOne(setName, id, bodyJson).then(
        function () { /* ok */ },
        function (err) {
          fails.push({ id: id, error: (err && err.message) || String(err) });
        }
      );
    });

    return Promise.all(promises).then(function () { return fails; });
  }

  function updateOne(setName, id, bodyJson) {
    var base = Xrm.Utility.getGlobalContext().getClientUrl();
    var url = base + "/api/data/v9.2/" + setName + "(" + id + ")";
    return fetch(url, {
      method: "PATCH",
      headers: {
        "OData-MaxVersion": "4.0",
        "OData-Version": "4.0",
        "Accept": "application/json",
        "Content-Type": "application/json; charset=utf-8",
        "If-Match": "*"
      },
      body: bodyJson
    }).then(function (resp) {
      if (resp.ok) return;
      return resp.text().then(function (t) {
        var msg = "HTTP " + resp.status;
        try {
          var parsed = JSON.parse(t);
          if (parsed && parsed.error && parsed.error.message) msg += ": " + parsed.error.message;
          else if (t) msg += ": " + t;
        } catch (e) {
          if (t) msg += ": " + t;
        }
        throw new Error(msg);
      });
    });
  }

  function showResult(selectedControl, verb, total, failures) {
    var succeeded = total - failures.length;
    var text = verb + " complete.\n\n" +
               "Updated: " + succeeded + "\n" +
               "Failed:  " + failures.length;
    if (failures.length) {
      var preview = failures.slice(0, 5).map(function (f) { return f.id + ": " + f.error; }).join("\n  ");
      var more = failures.length > 5 ? "\n  …and " + (failures.length - 5) + " more." : "";
      text += "\n\nFailures:\n  " + preview + more;
    }
    Xrm.Navigation.openAlertDialog({ text: text }).then(function () {
      if (selectedControl && typeof selectedControl.refresh === "function") {
        selectedControl.refresh();
      }
    });
  }

  return {
    certify: certify,
    decertify: decertify
  };
})();
