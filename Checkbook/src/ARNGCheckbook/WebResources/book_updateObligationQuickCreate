function manageFieldVisibility(executionContext) {
    var formContext = executionContext.getFormContext();
    var parentRecordReference = Xrm.Utility.getPageContext().input.createFromEntity;

    // Check if the Quick Create form was launched from a related record
    if (parentRecordReference != null) {
        // Get the ID, entity type, and name of the parent record
        var parentRecordId = parentRecordReference.id;
        var parentRecordEntityType = parentRecordReference.entityType;
        var parentRecordName = parentRecordReference.name;

        // Define the lookup field value object
        var lookupValue = [
            {
                id: parentRecordId,
                name: parentRecordName,
                entityType: parentRecordEntityType
            }
        ];

        // Get the field you want to show/hide.
        var reqField = formContext.getControl("book_requirement");
        var priField = formContext.getControl("book_prioritization");

        // Check the entity type of the parent record
        if (parentRecordEntityType == "book_prioritization") { // Launched from a Prioritization
            reqField.setVisible(false); // Hide Req field
            // Populate lookup field
            formContext.getAttribute("book_prioritization").setValue(lookupValue);

        } else if (parentRecordEntityType == "book_requirements") { // Launched from a Requirement
            priField.setVisible(false); // Hide the field
            // Populate lookup field
            formContext.getAttribute("book_requirement").setValue(lookupValue);
        } else {
            // If launched from a different entity or globally
            reqField.setVisible(true);
            priField.setVisible(true);
        }
    }
}