                "operationMetadataId": "a94a4139-439b-486f-bc81-cc04ec50ef39"
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "List_Prioritizations_associated_to_Requirement": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@triggerOutputs()['body/SdkMessage']",
              "Create"
            ]
          },
          "metadata": {
            "operationMetadataId": "d4f98397-b930-48f4-b036-fc71d8af377c"
