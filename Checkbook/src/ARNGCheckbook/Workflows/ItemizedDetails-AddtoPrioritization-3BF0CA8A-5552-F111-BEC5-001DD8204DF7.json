                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "book_itemizeddetailses",
                      "item/book_Prioritization@odata.bind": "book_prioritizations(@{items('Added_loop_through_Prioritizations')?['book_prioritizationid']})",
                      "item/owningbusinessunit@odata.bind": "businessunits(@{items('Added_loop_through_Prioritizations')?['_owningbusinessunit_value']})",
                      "item/book_RequirementItem@odata.bind": "book_requirementdetailses(@{triggerOutputs()?['body/book_requirementdetailsid']})"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {},
