              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "systemusers",
                  "fetchXml": "<fetch distinct=\"true\">\n  <entity name=\"systemuser\">\n    <attribute name=\"systemuserid\"/>\n    <attribute name=\"fullname\"/>\n    <filter>\n      <condition attribute=\"isdisabled\" operator=\"eq\" value=\"0\"/>\n    </filter>\n    <link-entity name=\"teammembership\" from=\"systemuserid\" to=\"systemuserid\" intersect=\"true\">\n      <filter>\n        <condition attribute=\"teamid\" operator=\"eq\" value=\"@{triggerOutputs()?['body/_ownerid_value']}\"/>\n      </filter>\n    </link-entity>\n  </entity>\n</fetch>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "For_each": {
              "foreach": "@outputs('List_Users_in_Team')?['body/value']",
              "actions": {
                "Send_Notification_to_all_Users": {
                  "metadata": {
                    "operationMetadataId": "d7387b8c-e653-4675-8aea-67d0039b924b"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "appnotifications",
                      "item/title": "Funded Amount Updated",
                      "item/body": "An NPM has updated the Funded Amount on Prioritization - '@{outputs('Grab_Prioritization')?['body/book_name']}'",
                      "item/data": "{\n  \"actions\": [\n    {\n      \"title\": \"Funded Amount Updated\",\n      \"data\": {\n        \"type\": \"url\",\n        \"url\": \"@{concat(parameters('ARNG Checkbook - Environment (book_ARNGCheckbookEnvironment)'), '/main.aspx?etn=book_prioritization&id=', triggerOutputs()?['body/book_prioritizationid'], '&pagetype=entityrecord')}\",\n        \"navigationTarget\": \"dialog\"\n      }\n    }\n  ]\n}",
                      "item/icontype": 100000000,
                      "item/ownerid@odata.bind": "systemusers(@{items('For_each')?['systemuserid']})",
                      "item/owningbusinessunit@odata.bind": "businessunits(@{triggerOutputs()?['body/_owningbusinessunit_value']})",
                      "item/toasttype": 200000000
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  }
                }
              },
              "runAfter": {
                "List_Users_in_Team": [
                  "Succeeded"
