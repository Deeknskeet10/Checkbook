      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "addbb9dc-830d-4af0-b96d-d63e8dca5838"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "book_linrequests",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "book_requestedamount, book_validatedamount, book_fundedamount",
              "subscriptionRequest/filterexpression": "statecode eq 0",
              "subscriptionRequest/runas": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "List_other_LINs": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "56f066cd-cdcd-4ea8-9e1f-63e26fbb543a"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "book_linrequestses",
              "fetchXml": "<fetch aggregate=\"true\">\n    <entity name=\"book_linrequests\">\n        <attribute name=\"book_fundedamount\" alias=\"funding\" aggregate=\"sum\"/>\n        <attribute name=\"book_requestedamount\" alias=\"requested\" aggregate=\"sum\"/>\n        <attribute name=\"book_validatedamount\" alias=\"validated\" aggregate=\"sum\"/>\n        <filter type=\"and\">\n            <condition attribute=\"book_prioritization\" operator=\"eq\" value=\"@{triggerOutputs()?['body/_book_prioritization_value']}\"/>\n            <condition attribute=\"statecode\" operator=\"eq\" value=\"0\"/>\n        </filter>\n    </entity>\n</fetch>"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Update_Prioritization": {
          "runAfter": {
            "List_other_LINs": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4f1da11b-3d28-4055-b0c6-dc31462a59f6"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "book_prioritizations",
              "recordId": "@triggerOutputs()?['body/_book_prioritization_value']",
              "item/book_requestedamount": "@if(equals(first(outputs('List_other_LINs')?['body/value'])?['requested'], null), 0.00, first(outputs('List_other_LINs')?['body/value'])?['requested'])",
              "item/book_fundedamounttdp": "@if(equals(first(outputs('List_other_LINs')?['body/value'])?['funded'], null), 0.00, first(outputs('List_other_LINs')?['body/value'])?['funded'])",
              "item/book_newvalidatedamount": "@if(equals(first(outputs('List_other_LINs')?['body/value'])?['validated'], null), 0.00, first(outputs('List_other_LINs')?['body/value'])?['validated'])"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      }
    },
    "templateName": null
