ndid\" to=\"book_fund\" link-type=\"inner\" alias=\"fund\">\n                <attribute name=\"book_fundid\" alias=\"fund_id\" groupby=\"true\"/>\n                <attribute name=\"book_name\" alias=\"fund_name\" groupby=\"true\"/>\n                <attribute name=\"book_fiscalyear\" alias=\"fy\" groupby=\"true\"/>\n            </link-entity>\n        </link-entity>\n    </entity>\n</fetch>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
