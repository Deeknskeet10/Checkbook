/**
 * Calls appropriate button's function based off of buttonID
 * @param {context} gridContext - view control
 * @param {list} selectedRecordIds - list of GUIDs of the selected records
 * @param {int} buttonId - serial for button selected
 */
async function checkbookButtons(gridContext, selectedRecordIds, buttonId) {
  /* Grab User Roles assigned via Team */
  var userTeamRoles = getUserRolesByTeamAssociation();

  /* Initialize Notifications */
  var successNotification = {
    type: 2,
    level: 1,
    message: "Success",
    showCloseButton: true,
  };

  switch (buttonId) {
    case 0:
      /* State Input -> FC Review */
      successNotification.message = await sendToFC(
        gridContext,
        selectedRecordIds,
        userTeamRoles
      );

      break;
    case 1:
      /* FC Review -> State Review (Approved) || State Review -> State Approved (Approved) */
      successNotification.message = await approveRecord(
        gridContext,
        selectedRecordIds,
        userTeamRoles
      );

      break;
    case 2:
      console.log("Case 2 - Reject");
      /* FC Review -> State Input (Rejected) || State Review -> State Input (Rejected) */
      successNotification.message = await rejectRecord(
        gridContext,
        selectedRecordIds,
        userTeamRoles
      );

      break;
    case 3:
      console.log("Case 3 - Send to NPM");
      /* State Approved -> NPM (Sent forward) */
      successNotification.message = await sendToNPM(
        gridContext,
        selectedRecordIds,
        userTeamRoles
      );

      break;
    case 4:
      console.log("Case 4 - Return to State PM");
      /* Rejected by NPM/Recalled by State -> State Input */
      successNotification.message = await returnToStatePM(
        gridContext,
        selectedRecordIds,
        userTeamRoles
      );

      break;
  }

  /* Send Notifications */
  await Xrm.App.addGlobalNotification(successNotification).then(
    function success(result) {
      console.log("Success notification displayed with ID: " + result);

      // Wait for 5 seconds and then clear the notification
      window.setTimeout(function () {
        Xrm.App.clearGlobalNotification(result);
      }, 5000);
    },
    function (error) {
      console.error("Error displaying success notification: " + error.message);
      // Handle error conditions if the notification fails to display
    }
  );
}
/** Choice Values
 * State Input - 0
 * State Review - 1
 * State Reviewed - 2
 * State Approved - 3
 * NPM Review - 4
 * */

/** Role Names
 * Book - State PM
 * Book - FC Reviewer
 * Book - State Approver
 * Book - State Administrator
 * Book - NPM
 */

/* Send to Fund Center Reviewer */
async function sendToFC(gridContext, selectedRecordIds, userTeamRoles) {
  var recordSent = 0;
  var recordDenied = 0;

  // Await the userTeamRoles promise to get the roles
  const roles = await userTeamRoles;

  if (roles.includes("Administrator") || roles.includes("State PM")) {
    if (selectedRecordIds && selectedRecordIds.length > 0) {
      // Use map to create an array of promises, and Promise.all to await them
      await Promise.all(
        selectedRecordIds.map(async function (recordId) {
          const entityName = "book_prioritization";
          const choiceField = "book_approvalstatus";
          const data = {};

          /*get Current value */
          const currentValue = await getCurrentChoiceValue(
            entityName,
            recordId,
            choiceField
          );

          if (currentValue == 0) {
            /*set choice field */
            data[choiceField] = 1;

            /* Update Approval Status */
            await updateApprovalStatus(entityName, recordId, data, gridContext); // Await the update

            /* Increment count */
            recordSent++; // Increment after successful update
          } else {
            /* Increment denied */
            recordDenied++; // Increment only if denied
          }
        })
      );
    } 
    /* set message */
  return `Of the selected Prioritizations, ${recordSent} were sent to the Fund Center for Review and ${recordDenied} lacked appropriate permissions to send forward.`;
  }
  else {
      return "You do not have the appropriate permissions to take action on any of the selected records.";
    }
  
}

/* Send to State Approver from FC Reviewer; or State Approver to Approved */
async function approveRecord(gridContext, selectedRecordIds, userTeamRoles) {
  var recordSent = 0;
  var recordDenied = 0;

  // Await the userTeamRoles promise to get the roles
  const roles = await userTeamRoles;

  if (selectedRecordIds && selectedRecordIds.length > 0) {
    await Promise.all(
      selectedRecordIds.map(async function (recordId) {
        const entityName = "book_prioritization"; // e.g., "account"
        const choiceField = "book_approvalstatus";
        const data = {};

        /*get Current value */
        const currentValue = await getCurrentChoiceValue(
          entityName,
          recordId,
          choiceField
        );

        /* FC Reviewer Approves record */
        if (
          currentValue == 1 &&
          (roles.includes("FC Reviewer") ||
            roles.includes("Administrator"))
        ) {

          /*set choice field */
          data[choiceField] = 2;

          /* Update Approval Status */
          await updateApprovalStatus(entityName, recordId, data, gridContext);

          /* Increment approved */
          recordSent++;
        } else if (
          /* State Approver approves record */
          currentValue == 2 &&
          (roles.includes("State Approver") ||
            roles.includes("Administrator"))
        ) {
          /*set choice field */
          data[choiceField] = 3;

          /* Update Approval Status */
          await updateApprovalStatus(entityName, recordId, data, gridContext);

          /* Increment approved */
          recordSent++;
        } else {
          recordDenied++;
        }
      })
    );
  }
  return `Of the selected Prioritizations, ${recordSent} were Approved and ${recordDenied} lacked appropriate permissions to Approve.`;
}

/* Reject from FC Reviewer or State Approver */
async function rejectRecord(gridContext, selectedRecordIds, userTeamRoles) {
  // Await the userTeamRoles promise to get the roles
  const roles = await userTeamRoles;

  if (selectedRecordIds && selectedRecordIds.length > 0) {
    const results = await Promise.all(
      selectedRecordIds.map(async function (recordId) {
        const entityName = "book_prioritization"; // e.g., "account"
        const choiceField = "book_approvalstatus";
        const data = {};
        let approved = false;

        /*get Current value */
        const currentValue = await getCurrentChoiceValue(
          entityName,
          recordId,
          choiceField
        );

        /* FC Reviewer Rejects record */
        if (
          currentValue == 1 &&
          (roles.includes("FC Reviewer") ||
            roles.includes("Administrator"))
        ) {
          /*set choice field */
          data[choiceField] = 0;

          /* Update Approval Status */
          await updateApprovalStatus(entityName, recordId, data, gridContext);

          /* Set approved */
          approved = true;
          console.log(approved)
        } else if (
          /* State Approver Rejects record */
          currentValue == 2 &&
          (roles.includes("State Approver") ||
            roles.includes("Administrator"))
        ) {
          /*set choice field */
          data[choiceField] = 1;

          /* Update Approval Status */
          await updateApprovalStatus(entityName, recordId, data, gridContext);

          /* Set approved */
          approved = true;

        }
        return approved;
      })
    );

    const recordSent = results.filter(Boolean).length; // Count records that were approved
    const recordDenied = selectedRecordIds.length - recordSent;

    return `Of the selected Prioritizations, ${recordSent} were Rejected and ${recordDenied} lacked appropriate permissions to Reject.`;
  } 
}

/* Send to NPM */
async function sendToNPM(gridContext, selectedRecordIds, userTeamRoles) {
  var recordSent = 0;
  var recordDenied = 0;

  // Await the userTeamRoles promise to get the roles
  const roles = await userTeamRoles;
  if (
    roles.includes("Administrator") ||
    roles.includes("State Approver")
  ) {
    if (selectedRecordIds && selectedRecordIds.length > 0) {
      await Promise.all(
        selectedRecordIds.map(async function (recordId) {
          const entityName = "book_prioritization"; // e.g., "account"
          const choiceField = "book_approvalstatus";
          const data = {};

          /*get Current value */
          const currentValue = await getCurrentChoiceValue(
            entityName,
            recordId,
            choiceField
          );

          /*set choice field */
          if (currentValue == 3) {
            data[choiceField] = 4;

            /* Update Approval Status */
            await updateApprovalStatus(entityName, recordId, data, gridContext);

            /* Increment approved */
            recordSent++;
          } else {
            recordDenied++;
          }
        })
      );
    } 
    return `Of the selected Prioritizations, ${recordSent} were Sent to the NPM and ${recordDenied} were not ready/permitted to be Sent.`;
  }
  else {
      return "You do not have the appropriate permissions to take action on any of the selected records.";
    }
}

/* Return to State Input */
async function returnToStatePM(gridContext, selectedRecordIds, userTeamRoles) {
    var recordSent = 0;
    var recordDenied = 0;
    var notificationPromises = []; // Collect notification promises

    // Await the userTeamRoles promise to get the roles
    const roles = await userTeamRoles;

    if (selectedRecordIds && selectedRecordIds.length > 0) {
        await Promise.all(
            selectedRecordIds.map(async function (recordId) {
                const entityName = "book_prioritization";
                const choiceField = "book_approvalstatus";
                const data = {};

                /* Get current value */
                const currentValue = await getCurrentChoiceValue(
                    entityName,
                    recordId,
                    choiceField
                );

                /* Get record name for notification */
                let recordName = "";
                try {
                    const record = await Xrm.WebApi.retrieveRecord(
                        entityName,
                        recordId,
                        "?$select=book_name"
                    );
                    recordName = record.book_name || "Prioritization";
                } catch (e) {
                    recordName = "Prioritization";
                }

                /* State Approver returns from State Approved */
                if (
                    currentValue == 3 &&
                    (roles.includes("State Approver") ||
                        roles.includes("Administrator"))
                ) {
                    /* Set choice field */
                    data[choiceField] = 0;

                    /* Update Approval Status */
                    await updateApprovalStatus(entityName, recordId, data, gridContext);

                    /* Increment approved */
                    recordSent++;

                } else if (
                    /* NPM Returns record or State Approver pulls back - FROM NPM REVIEW */
                    currentValue == 4 &&
                    (roles.includes("State Approver") || roles.includes("NPM"))
                ) {
                    /* Set choice field */
                    data[choiceField] = 0;

                    /* Update Approval Status */
                    await updateApprovalStatus(entityName, recordId, data, gridContext);

                    /* Queue notification - returned from NPM Review */
                    notificationPromises.push(
                        sendNotificationToRecordOwner(
                            recordId,
                            recordName,
                            "Prioritization Returned from NPM",
                            "**" + recordName + "** has been returned from NPM Review and requires your attention.",
                            100000003 // Warning icon
                        )
                    );

                    /* Increment approved */
                    recordSent++;

                } else {
                    recordDenied++;
                }
            })
        );

        /* Send all notifications (fire and forget - don't block UI) */
        if (notificationPromises.length > 0) {
            Promise.all(notificationPromises).then(function () {
                console.log("All return notifications sent successfully.");
            }).catch(function (error) {
                console.error("Error sending some notifications: " + error.message);
            });
        }
    }

    return `Of the selected Prioritizations, ${recordSent} were returned to the State PM and ${recordDenied} lacked appropriate permissions to Return.`;
}

async function getCurrentChoiceValue(entityName, recordId, choiceField) {
  /* Grab current value of Approval Status */
  try {
    const record = await Xrm.WebApi.retrieveRecord(
      entityName,
      recordId,
      `?$select=${choiceField}` // Using template literals for clarity
    );
    // Get the value of the choice field (numeric representation)
    console.log(`The Value of the Choice is: ${record[choiceField]}`);
    return record[choiceField]; // This will return the actual value
  } catch (error) {
    console.error(
      `Error retrieving choice value for record ${recordId}: ${error.message}`
    );
    throw error; // Re-throw the error to be caught by the calling function
  }
}

async function updateApprovalStatus(entityName, recordId, data, gridContext) {
  try {
    await Xrm.WebApi.updateRecord(entityName, recordId, data); // Await the update operation
    console.log("Record updated successfully: " + recordId);
    gridContext.refresh();
  } catch (error) {
    console.error("Error updating record " + recordId + ": " + error.message);
    throw error; // Re-throw the error to be caught by the calling function's catch block
  }
}
