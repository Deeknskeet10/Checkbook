var InAppNotificationWrapper = window.InAppNotificationWrapper || {};

InAppNotificationWrapper.SendAppNotificationRequest = function (options) {
    this.Title = options.title;
    this.Recipient = options.recipient;
    this.Body = options.body || "";
    this.Priority = options.priority || 200000000;
    this.IconType = options.iconType || 100000000;
    this.ToastType = options.toastType || 200000000;
    this.Expiry = options.expiry || 120;
    this.OverrideContent = options.overrideContent || null;
    this.Actions = options.actions || null;
};

InAppNotificationWrapper.SendAppNotificationRequest.prototype.getMetadata = function () {
    return {
        boundParameter: null,
        parameterTypes: {
            "Title": { "typeName": "Edm.String", "structuralProperty": 1 },
            "Recipient": { "typeName": "mscrm.systemuser", "structuralProperty": 5 },
            "Body": { "typeName": "Edm.String", "structuralProperty": 1 },
            "Priority": { "typeName": "Edm.Int32", "structuralProperty": 1 },
            "IconType": { "typeName": "Edm.Int32", "structuralProperty": 1 },
            "ToastType": { "typeName": "Edm.Int32", "structuralProperty": 1 },
            "Expiry": { "typeName": "Edm.Int32", "structuralProperty": 1 },
            "OverrideContent": { "typeName": "mscrm.expando", "structuralProperty": 5 },
            "Actions": { "typeName": "mscrm.expando", "structuralProperty": 5 }
        },
        operationType: 0,
        operationName: "SendAppNotification"
    };
};

InAppNotificationWrapper.send = function (options) {
    var request = new InAppNotificationWrapper.SendAppNotificationRequest(options);

    return Xrm.WebApi.online.execute(request).then(
        function (response) {
            if (response.ok) {
                return response.json();
            }
            throw new Error("Notification failed: " + response.statusText);
        }
    ).then(function (responseBody) {
        console.log("Notification sent. ID: " + responseBody.NotificationId);
        return responseBody.NotificationId;
    }).catch(function (error) {
        console.error("SendAppNotification error: " + error.message);
    });
};

/**
 * Sends notification to owner (handles both user and team owners)
 * @param {string} recordId - GUID of the prioritization record
 * @param {string} recordName - Name of the record for display
 * @param {string} title - Notification title
 * @param {string} body - Notification body
 * @param {number} iconType - Icon type (100000000=Info, 100000001=Success, 100000002=Failure, 100000003=Warning)
 */
async function sendNotificationToRecordOwner(recordId, recordName, title, body, iconType) {
    try {
        // Get owner info from the record
        const record = await Xrm.WebApi.retrieveRecord(
            "book_prioritization",
            recordId,
            "?$select=book_name&$expand=ownerid($select=ownerid)"
        );

        // Get owner reference via OData
        const ownerIdResponse = await Xrm.WebApi.retrieveRecord(
            "book_prioritization",
            recordId,
            "?$select=_ownerid_value"
        );

        const ownerId = ownerIdResponse._ownerid_value;
        const ownerType = ownerIdResponse["_ownerid_value@Microsoft.Dynamics.CRM.lookuplogicalname"];

        // Build record URL
        const recordUrl = Xrm.Utility.getGlobalContext().getClientUrl() +
            "/main.aspx?etn=book_prioritization&id=" + recordId + "&pagetype=entityrecord";

        // Build notification options
        const notificationOptions = {
            title: title,
            body: body,
            iconType: iconType || 100000003, // Warning
            toastType: 200000000,
            actions: {
                "@odata.type": "#Microsoft.Dynamics.CRM.expando",
                "actions@odata.type": "#Collection(Microsoft.Dynamics.CRM.expando)",
                "actions": [
                    {
                        "@odata.type": "#Microsoft.Dynamics.CRM.expando",
                        "title": "View Record",
                        "data": {
                            "@odata.type": "#Microsoft.Dynamics.CRM.expando",
                            "type": "url",
                            "url": recordUrl,
                            "navigationTarget": "dialog"
                        }
                    }
                ]
            }
        };

        // Get list of user IDs to notify
        const userIds = await getOwnerUserIds(ownerId, ownerType);

        // Send notification to each user
        const sendPromises = userIds.map(function (userId) {
            const userNotification = Object.assign({}, notificationOptions);
            userNotification.recipient = "/systemusers(" + userId + ")";
            return InAppNotificationWrapper.send(userNotification);
        });

        await Promise.all(sendPromises);
        console.log(`Sent ${userIds.length} notification(s) for record ${recordId}`);

    } catch (error) {
        console.error("Error sending notification for record " + recordId + ": " + error.message);
    }
}

/**
 * Gets user IDs from owner (single user or team members)
 * @param {string} ownerId - GUID of owner (user or team)
 * @param {string} ownerType - "systemuser" or "team"
 * @returns {Promise<string[]>} Array of user GUIDs
 */
async function getOwnerUserIds(ownerId, ownerType) {
    if (ownerType === "systemuser") {
        return [ownerId];
    }

    if (ownerType === "team") {
        // Query team membership
        const fetchXml = `
            <fetch distinct="true">
                <entity name="systemuser">
                    <attribute name="systemuserid"/>
                    <filter>
                        <condition attribute="isdisabled" operator="eq" value="0"/>
                    </filter>
                    <link-entity name="teammembership" from="systemuserid" to="systemuserid" intersect="true">
                        <filter>
                            <condition attribute="teamid" operator="eq" value="${ownerId}"/>
                        </filter>
                    </link-entity>
                </entity>
            </fetch>`;

        const result = await Xrm.WebApi.retrieveMultipleRecords(
            "systemuser",
            "?fetchXml=" + encodeURIComponent(fetchXml)
        );

        return result.entities.map(function (user) {
            return user.systemuserid;
        });
    }

    return [];
}

