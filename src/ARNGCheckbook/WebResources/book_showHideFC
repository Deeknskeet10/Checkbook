function showHideFields(executionContext) {
    var formContext = executionContext.getFormContext();
    var fieldToCheck = formContext.getAttribute("book_requirementfunding").getValue();
    var fieldToToggle = formContext.getControl("book_fundcenter");

    if (fieldToCheck != null) {
        Xrm.WebApi.retrieveRecord("book_requirementfunding", fieldToCheck[0].id.replace(/[{}]/g, ''),"?$expand=book_Requirement($select=book_national)").then(
            function success(result) {
                var isNational = result.book_Requirement?.book_national;
                console.log(isNational);
                
                if (isNational === true) {
                    formContext.getAttribute("book_fundcenter").setRequiredLevel("none");
                    fieldToToggle.setVisible(false);
                } else {
                    formContext.getAttribute("book_fundcenter").setRequiredLevel("required");
                    fieldToToggle.setVisible(true);
                }
            },
            function (error) {
                console.log(error.message);
            }
        );
    }    
}