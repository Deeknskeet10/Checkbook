{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "book_sharedcommondataserviceforapps_9388f"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "fc33c858-a88a-40d9-b753-ff4fb782e0eb"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "book_decisionevent",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "statecode",
              "subscriptionRequest/filterexpression": "statecode eq 1",
              "subscriptionRequest/runas": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "List_Decisions": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "92cd54b9-7c1d-40c6-8ac3-ea45d0bef14a"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "book_decisions",
              "$filter": "statecode eq 0 and _book_event_value eq @{triggerOutputs()?['body/book_decisioneventid']}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Loop_through_Decisions": {
          "foreach": "@outputs('List_Decisions')?['body/value']",
          "actions": {
            "Deactivate_Decision": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "13af4033-71a8-400a-86f9-f8cdc0543607"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "book_decisions",
                  "recordId": "@items('Loop_through_Decisions')?['book_decisionid']",
                  "item/statecode": 1
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "List_Decisions": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "457c2ae6-a304-4027-900e-e0543fef632e"
          },
          "type": "Foreach"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}