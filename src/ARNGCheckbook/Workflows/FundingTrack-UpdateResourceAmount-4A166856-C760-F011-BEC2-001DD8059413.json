          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "book_decisions",
              "fetchXml": "<fetch aggregate=\"true\">\n    <entity name=\"book_decision\">\n        <attribute name=\"book_amount\" alias=\"amount\" aggregate=\"sum\"/>\n        <filter type=\"and\">\n            <condition attribute=\"statecode\" operator=\"eq\" value=\"0\"/>\n            <condition attribute=\"book_fundingline\" operator=\"eq\" value=\"@{triggerOutputs()?['body/_book_fundingline_value']}\"/>\n        </filter>\n        <link-entity name=\"book_fundingtrack\" from=\"book_fundingtrackid\" to=\"book_fundingline\" link-type=\"inner\" alias=\"opr\">\n            <attribute name=\"book_beginningbalancereadonly\" alias=\"begin_balance\" groupby=\"true\"/>\n        </link-entity>\n    </entity>\n</fetch"
            },
