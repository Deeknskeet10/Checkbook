            ]
          },
          "metadata": {
            "operationMetadataId": "8bfd53e9-4c3e-40fe-aecb-c290dae78139"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "book_fundingtracks",
              "recordId": "@triggerOutputs()?['body/_book_fundingline_value']",
              "item/book_resourceamount": "@add(if(equals(first(outputs('List_Decisions')?['body/value'])?['begin_balance'], null), 0.00, first(outputs('List_Decisions')?['body/value'])?['begin_balance']), if(equals(first(outputs('List_Decisions')?['body/value'])?['amount'], null), 0.00, first(outputs('List_Decisions')?['body/value'])?['amount']))"
            },
