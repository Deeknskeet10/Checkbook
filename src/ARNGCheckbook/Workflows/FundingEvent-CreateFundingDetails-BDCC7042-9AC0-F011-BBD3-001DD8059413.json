          "runAfter": {},
          "metadata": {
            "operationMetadataId": "ab503fe9-634d-47da-81ad-abc57ed227cf"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "book_fundinglines",
              "$filter": "book_Fund/book_fiscalyear eq @{triggerOutputs()?['body/book_fiscalyear']}",
              "fetchXml": "<fetch aggregate=\"true\">\n    <entity name=\"book_fundingline\">\n        <attribute name=\"book_fundinglineid\" alias=\"loa\" aggregate=\"count\"/>\n        <link-entity name=\"book_pg\" from=\"book_pgid\" to=\"book_pg\" link-type=\"inner\" alias=\"pg\">\n            <attribute name=\"book_name\" alias=\"pg_name\" groupby=\"true\"/>\n            <attribute name=\"book_pgid\" alias=\"pg_id\" groupby=\"true\"/>\n        </link-entity>\n        <link-entity name=\"book_fund\" from=\"book_fundid\" to=\"book_fund\" link-type=\"inner\" alias=\"fund\">\n            <attribute name=\"book_name\" alias=\"fund_name\" groupby=\"true\"/>\n            <attribute name=\"book_fundid\" alias=\"fund_id\" groupby=\"true\"/>\n            <attribute name=\"book_fiscalyear\" alias=\"fy\" groupby=\"true\"/>\n        </link-entity>\n    </entity>\n</fetch>",
              "$expand": "book_Fund($select=book_fiscalyear)"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_Unique_LOAs')?['body/value']",
          "actions": {
            "New_Funding_Detail": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "a7bc0bcc-5723-462e-b76a-fbc2d7e166d7"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "book_fundingdetailses",
                  "item/book_Fund@odata.bind": "book_funds(@{items('Apply_to_each')?['fund_id']})",
                  "item/book_FundingEvent@odata.bind": "book_fundingevents(@{triggerOutputs()?['body/book_fundingeventid']})",
                  "item/owningbusinessunit@odata.bind": "businessunits(@{triggerOutputs()?['body/_owningbusinessunit_value']})",
                  "item/book_PGSAG@odata.bind": "book_pgs(@{items('Apply_to_each')?['pg_id']})"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "List_Unique_LOAs": [
              "Succeeded"
            ]
          },
          "metadata": {
