            "parameters": {
              "entityName": "book_requirementfundings",
              "fetchXml": "<fetch>\n    <entity name=\"book_requirementfunding\">\n        <filter type=\"and\">\n            <condition attribute=\"statecode\" operator=\"eq\" value=\"0\"/>\n            <condition attribute=\"book_ufrgenerated\" operator=\"eq\" value=\"0\"/>\n        </filter>\n        <link-entity name=\"book_requirements\" from=\"book_requirementsid\" to=\"book_requirement\" link-type=\"inner\" alias=\"reqs\">\n            <filter type=\"and\">\n                <condition attribute=\"book_requirementapproved\" operator=\"eq\" value=\"1\"/>\n                <condition attribute=\"statecode\" operator=\"eq\" value=\"0\"/>\n            </filter>\n        </link-entity>\n        <link-entity name=\"book_fundingline\" from=\"book_fundinglineid\" to=\"book_lineofaccounting\" link-type=\"inner\" alias=\"loa\"/>\n        <link-entity name=\"book_mdep\" from=\"book_mdepid\" to=\"book_mdep\" link-type=\"inner\" alias=\"mdep\">\n            <filter type=\"and\">\n                <condition attribute=\"book_name\" operator=\"ne\" value=\"RISK\"/>\n            </filter>\n        </link-entity>\n    </entity>\n</fetch>"
