<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="ARNGCheckbook" constructor="DecisionLedgerBalance" version="0.1.0" display-name-key="DecisionLedgerBalance" description-key="Statement-style view of book_decision records (Decision Ledger) against a Funding Track. Each row shows the signed amount and a running balance starting from the parent Funding Tracks beginning balance. Grouped by Decision Event with a balance sparkline." control-type="virtual">
    <data-set name="decisions" display-name-key="Decisions">
      <property-set name="name" display-name-key="Description" of-type="SingleLine.Text" usage="bound" required="false" />
      <property-set name="amount" display-name-key="Amount" of-type="FP" usage="bound" required="true" />
      <property-set name="event" display-name-key="Decision Event" of-type="Lookup.Simple" usage="bound" required="false" />
      <property-set name="createdOn" display-name-key="Created On" of-type="DateAndTime.DateAndTime" usage="bound" required="false" />
    </data-set>
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/DecisionLedgerBalance.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
